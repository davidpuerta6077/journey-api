# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001

# ─── POSTGRESQL ───────────────────────────────────────────────────────────────
POSTGRESQL_HOST=127.0.0.1
POSTGRESQL_USER=tu_usuario
POSTGRESQL_PASSWORD=tu_password
POSTGRESQL_DB=journey
SCHEMA=test
DB_PORT=5432

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_seguro

# ─── ADMIN (generar hash con: node -e "require('bcrypt').hash('tuPassword',12).then(console.log)")
ADMIN_EMAIL=admin@journey.com
ADMIN_PASSWORD_HASH=hash_bcrypt_de_tu_password

# ─── MOODLE ───────────────────────────────────────────────────────────────────
MOODLE_URL=https://tu-moodle.edu.co/webservice/rest/server.php
MOODLE_TOKEN=tu_token_de_moodle

# ─── MOODLE DB (MySQL) ────────────────────────────────────────────────────────
MOODLE_DB_HOST=tu_host_rds
MOODLE_DB_USER=tu_usuario_mysql
MOODLE_DB_PASSWORD=tu_password_mysql
MOODLE_DB_NAME=tu_base_de_datos

# ─── MOODLE CLI ───────────────────────────────────────────────────────────────
PHP_PATH=C:\xampp\php\php.exe
MOODLE_PATH=C:\xampp\htdocs\moodle

# ─── DOMINIO ──────────────────────────────────────────────────────────────────
URL_BASE=https://localhost:3001

# ─── LÍMITES ──────────────────────────────────────────────────────────────────
MAX_ROWS=5000

# IA (módulo Informes Onix-IA): ollama | claude | gemini | openai (openai = cualquier API compatible: OpenAI, Groq, DeepSeek, OpenRouter...)
IA_PROVIDER=ollama
ANTHROPIC_API_KEY=
IA_MODEL=
OLLAMA_URL=http://10.0.17.77:11434
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1
# Clave maestra (cadena aleatoria larga) para cifrar la API key guardada en Configuración > Inteligencia artificial
IA_SECRET_KEY=

# Google Calendar en Informes: se configura en Configuración > Google (lo guardado ahí manda); esto es solo respaldo
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/onix/google/callback
# URL del front a la que vuelve el navegador tras conectar con Google
FRONT_URL=http://localhost:5173
